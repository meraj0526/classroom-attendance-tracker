{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: Attendance Tracker",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "env": { "FLASK_DEBUG": "0", "PORT": "5000" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
