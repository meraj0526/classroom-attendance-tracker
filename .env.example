# =====================================================================
# Classroom Attendance Tracker - configuration template
#
# 1. Copy this file to .env        (Copy-Item .env.example .env)
# 2. Replace EVERY placeholder below with your own values.
# 3. Never commit .env - it is listed in .gitignore.
#
# Used by Podman:      podman run --env-file .env ...
# Used locally:        load it into PowerShell (see README section 7.3)
#
# Rules for this file: one KEY=value per line, no quotes around values,
# no spaces around "=". Lines starting with # are comments.
#
# There are no built-in passwords. If a password below is missing, empty or
# still REPLACE_WITH..., a random one is generated on first start and printed
# ONCE to the terminal / `podman logs`.
# =====================================================================

# Signs the login session cookie. Use 64 random characters.
# Generate one in PowerShell:  python -c "import secrets; print(secrets.token_hex(32))"
# If omitted, the app generates a key and stores it in /app/data/secret_key.
SECRET_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# First teacher account. Applied ONLY when the database has no teacher yet
# (a brand-new volume or data folder). Change it later in Profile.
# Username: 3-40 characters - letters, digits, dot, underscore or hyphen.
TEACHER_USERNAME=REPLACE_WITH_TEACHER_USERNAME
# Password: at least 8 characters with letters and digits. Must not be empty.
TEACHER_PASSWORD=REPLACE_WITH_A_STRONG_TEACHER_PASSWORD
TEACHER_NAME=Class Teacher

# Initial Student Portal password given to the fictional sample students on a new
# database (and to existing students when an older database is upgraded).
# Must not be empty. Teachers can reset each student's password afterwards.
DEFAULT_STUDENT_PASSWORD=REPLACE_WITH_A_STRONG_STUDENT_PASSWORD

# 1 = load 20 fictional sample students into a brand-new database, 0 = start empty
SEED_SAMPLE_DATA=1

# 1 only when the app is served over HTTPS (behind a reverse proxy)
SESSION_COOKIE_SECURE=0
